# --- Client (build-time) ---
# Set automatically by `npx convex dev` into .env.local. Copy that value here
# only if you want a committed example. Points the browser at your deployment.
VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud

# --- Backend (Convex) ---
# These are NOT read from this file. Set them on the deployment with:
#   npx convex env set TRANSLATOR_PASSWORD "your-shared-password"
#   npx convex env set SESSION_SECRET "$(openssl rand -hex 32)"
